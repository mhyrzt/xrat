Output docs/src/media/gif/cli.gif

Set Shell "bash"
Set Theme { "name": "XRAT", "black": "#15161e", "red": "#ff5c57", "green": "#5fd787", "yellow": "#ffcc66", "blue": "#7aa2f7", "magenta": "#bb9af7", "cyan": "#4fd6e8", "white": "#e6e1cf", "brightBlack": "#6f7488", "brightRed": "#ff6b61", "brightGreen": "#67d98f", "brightYellow": "#ffd166", "brightBlue": "#8ab4ff", "brightMagenta": "#c4a7ff", "brightCyan": "#5de4f2", "brightWhite": "#fff7e6", "background": "#101116", "foreground": "#e6e1cf", "selection": "#2f3444", "cursor": "#e6e1cf" }
Set FontFamily "FiraCode Nerd Font, Noto Color Emoji, Noto Emoji"
Set FontSize 16
Set Width 1200
Set Height 760
Set LoopOffset 80%
Env TERM "xterm-256color"
Env COLORTERM "truecolor"
Env CLICOLOR_FORCE "1"
Env FORCE_COLOR "1"
Env LANG "en_US.UTF-8"
Env LC_CTYPE "en_US.UTF-8"

Type "TERM=xterm-256color COLORTERM=truecolor CLICOLOR_FORCE=1 FORCE_COLOR=1 LANG=en_US.UTF-8 LC_CTYPE=en_US.UTF-8 xrat --help"
Enter
Sleep 2s
